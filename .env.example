# Convex (written by `npx convex dev`)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk — publishable keys are public; the secret key is web-server only and must
# never reach the mobile bundle or any client code.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Set this one on the Convex dashboard, not here: your Clerk Frontend API URL
# CLERK_JWT_ISSUER_DOMAIN=https://<verb>-<noun>-00.clerk.accounts.dev
