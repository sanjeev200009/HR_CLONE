# From `npx convex dev` in the repo root (.env.local there)
NEXT_PUBLIC_CONVEX_URL=

# Clerk. The publishable key is public; CLERK_SECRET_KEY is server-only and must
# never be referenced from a "use client" file.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
